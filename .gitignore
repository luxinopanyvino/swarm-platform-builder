# Hostinger: config con secretos (se sube solo al servidor, nunca al repo)
hostinger/api/db.php

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment variables
.env
.env.local

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Local cache and DB storage
storage/
backend/app/.rag_local/
# Per-project paper figures (SPEC-022/T11.5): binarios locales, nunca versionados
backend/app/.assets/
docs/.vitepress/cache/

# Graphify knowledge-graph build artifacts (local only)
graphify-out/

# Bases SQLite locales (datos de desarrollo y de tests: nunca versionados).
# Regla general y no por directorio: `backend/dev.db` estaba trackeado precisamente
# porque las reglas anteriores solo cubrían `backend/data/` y `backend/tests/`, y
# un arranque desde otro cwd deja el fichero en cualquier otro sitio.
*.db
*.sqlite
*.sqlite3
# Ficheros auxiliares que SQLite crea junto a la base (journal / WAL).
*.db-journal
*.db-wal
*.db-shm

# Claude Code: configuración personal (puede contener secretos/credenciales).
# La configuración compartida del equipo va en .claude/settings.json (versionada).
.claude/settings.local.json
.claude/*.local.json

# Certificados TLS del compose de producción (SPEC-017/T3.4). Una clave privada
# versionada es una clave comprometida, aunque sea de preproducción.
certs/*.pem
certs/*.key
certs/*.crt

# Informes del harness EDD (SPEC-014/T9.3): artefacto de una ejecución concreta,
# no fuente de verdad. En CI (T9.5) se publican como artifact del workflow.
backend/evals/results/
